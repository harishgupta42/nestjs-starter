# Copy to .env (or .env.development / src/config/development.env) and fill in real values.
# Real env files are git-ignored; only this example is committed.

# ---- App -------------------------------------------------------------------
NODE_ENV=development                 # development | production | test (picks .env.<NODE_ENV>, dev OTP is fixed to 123456)
NAME=NestJS Starter                  # Swagger title
DESCRIPTION=NestJS starter API       # Swagger description
VERSION=0.1.0                        # Swagger version
PORT=3000                            # HTTP port
BASE_PATH=                           # Global route prefix, e.g. api/v1 (leave empty for none)
SET_SWAGGER=true                     # 'true' serves Swagger UI at /<BASE_PATH>/swagger

# ---- MongoDB ---------------------------------------------------------------
DB_HOST=mongodb://localhost:27017    # Mongo connection URI
DB_USERNAME=                         # Mongo user (blank for no auth)
DB_PASSWORD=                         # Mongo password
DB_NAME=nestjs_starter               # Database name (also used as authSource)

# ---- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string   # HS256 signing secret for access tokens
SALT_ROUNDS=10                       # bcrypt cost factor
API_KEYS=local-dev-key               # Comma-separated keys accepted in the x-api-key header (ApiKeyAuthGuard)

# ---- Admin seed (runs once on boot when no admin with ADMIN_SEED_EMAIL exists) ----
ADMIN_SEED_EMAIL=admin@example.com   # Email of the first admin account
ADMIN_SEED_PASSWORD=                 # Required in production; if unset elsewhere the seed is skipped

# ---- Google OAuth ----------------------------------------------------------
GOOGLE_CLIENT_ID=                    # OAuth client id (also used to verify id tokens on /user/auth/google/verify)
GOOGLE_SECRET_ID=                    # OAuth client secret
GOOGLE_CALLBACK_URL=http://localhost:3000/user/auth/google/redirect

# ---- Facebook OAuth --------------------------------------------------------
FACEBOOK_APP_ID=                     # Facebook app id
FACEBOOK_APP_SECRET=                 # Facebook app secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/user/auth/facebook/redirect

# ---- SMTP (nodemailer via @nestjs-modules/mailer) --------------------------
SMTP_HOST=smtp.example.com           # SMTP server
SMTP_PORT=465                        # SMTP port
SMTP_SECURE=true                     # 'false' to disable implicit TLS (e.g. port 587)
SMTP_USER=no-reply@example.com       # SMTP login / default sender
SMTP_PASSWORD=                       # SMTP password (used when SMTP_PRIVATE_KEY is empty)
SMTP_FROM=no-reply@example.com       # From address on outgoing mail (defaults to SMTP_USER)
SMTP_CLIENT_ID=                      # Optional: Google service-account client id for OAuth2 SMTP
SMTP_PRIVATE_KEY=                    # Optional: Google service-account private key (\n escaped); enables OAuth2 SMTP

# ---- Twilio SMS ------------------------------------------------------------
TWILIO_ACCOUNT_SID=                  # Twilio account SID (SMS disabled when empty)
TWILIO_AUTH_TOKEN=                   # Twilio auth token
TWILIO_FROM=                         # Sending number in E.164 format, e.g. +15555550123

# ---- S3-compatible object storage (AWS S3, DigitalOcean Spaces, MinIO) -----
S3_REGION=us-east-1                  # Bucket region
S3_ENDPOINT=                         # Custom endpoint URL (leave empty for AWS)
S3_ACCESS_KEY_ID=                    # Access key
S3_SECRET_ACCESS_KEY=                # Secret key
S3_BUCKET=                           # Bucket name
S3_PUBLIC_URL=                       # Public base URL of the bucket, used to build returned file URLs
